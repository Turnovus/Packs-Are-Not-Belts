<?xml version="1.0" encoding="UTF-8"?>

<Patch>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="APM_Apparel_MechamancerPack"]/apparel/bodyPartGroups</xpath>
        <value>
            <bodyPartGroups>
                <li>Torso</li>
            </bodyPartGroups>
        </value>
    </Operation>

    <Operation Class="PacksAreNotBelts.PatchOperationModSetting">
        <setting>useMechLayer</setting>
        <operation Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="APM_Apparel_MechamancerPack"]/apparel/layers</xpath>
            <value>
                <layers>
                    <li>PacksAreNotBelts_Mechanitor</li>
                </layers>
            </value>
        </operation>
    </Operation>
</Patch>